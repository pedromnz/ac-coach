{"Variables": {"DashboardVariables": [{"VariableName": "dashName", "EvaluateOnlyOnce": false, "OverrideWithParentDashboardVariableWhenAvailable": false, "ValueExpression": {"Expression": "'LovelyDashboard'"}, "EvaluateBeforeScreenRoles": true}, {"VariableName": "folderName", "EvaluateOnlyOnce": false, "OverrideWithParentDashboardVariableWhenAvailable": false, "ValueExpression": {"Expression": "'Lovely Dashboard'"}, "EvaluateBeforeScreenRoles": true}, {"VariableName": "dashVer", "EvaluateOnlyOnce": false, "OverrideWithParentDashboardVariableWhenAvailable": false, "ValueExpression": {"JSExt": 1, "Interpreter": 1, "Expression": "return eval( $prop('variable.dashName') + 'Ver' );"}, "EvaluateBeforeScreenRoles": false}, {"VariableName": "pluginVer", "EvaluateOnlyOnce": false, "OverrideWithParentDashboardVariableWhenAvailable": false, "ValueExpression": {"JSExt": 1, "Interpreter": 1, "Expression": "return pluginVer;"}, "EvaluateBeforeScreenRoles": false}, {"VariableName": "shVer", "EvaluateOnlyOnce": false, "OverrideWithParentDashboardVariableWhenAvailable": false, "ValueExpression": {"JSExt": 1, "Interpreter": 1, "Expression": "return shVer;"}, "EvaluateBeforeScreenRoles": false}, {"VariableName": "ar_aimState", "EvaluateOnlyOnce": false, "OverrideWithParentDashboardVariableWhenAvailable": true, "ValueExpression": {"JSExt": 1, "Interpreter": 1, "Expression": "// Initialize button press counter\r\nif ( root['buttonPressCount'] == null) {\r\n    root['buttonPressCount'] = 0;\r\n}\r\n\r\nvar ClutchModeState = getcontrollerbuttonstate('0x35EE,*', 78); // Check state of ClutchMode\r\n\r\n// If ClutchMode is pressed\r\nif (ClutchModeState) {\r\n    var ClutchModeSel = getcontrollerbuttonstate('0x35EE,*', 79); // Check state of ClutchModeSel\r\n\r\n    // If ClutchModeSel is pressed and not handled\r\n    if (ClutchModeSel && !root['buttonPressHandled']) {\r\n        // Increment button press count\r\n        root['buttonPressCount']++;\r\n        // Set buttonPressHandled to true to indicate the press has been handled\r\n        root['buttonPressHandled'] = true;\r\n    } else if (!ClutchModeSel) {\r\n        // Reset buttonPressHandled when ClutchModeSel is released\r\n        root['buttonPressHandled'] = false;\r\n    }\r\n\t\r\n\treturn root['buttonPressCount'];\r\n\r\n}\r\n\r\n// Reset button press count when ClutchMode is released\r\nroot['buttonPressCount'] = 0;\r\n// Reset buttonPressHandled when ClutchMode is released\r\nroot['buttonPressHandled'] = false;\r\n\r\n// No output if ClutchMode is not pressed\r\nreturn '';"}, "EvaluateBeforeScreenRoles": true}, {"VariableName": "acCoach", "EvaluateOnlyOnce": false, "OverrideWithParentDashboardVariableWhenAvailable": false, "ValueExpression": {"JSExt": 1, "Interpreter": 1, "Expression": "var t = readtextfile('E:\\\\SteamLibrary\\\\steamapps\\\\common\\\\assettocorsa\\\\apps\\\\python\\\\ac_coach\\\\live.txt');\r\nif (t != null && String(t).indexOf('#end') >= 0) { root.t = String(t).replace(/\\r/g, ''); }\r\nreturn root.t || '';"}, "EvaluateBeforeScreenRoles": false}]}, "DashboardDebugManager": {"_dashSettingsStores": {}, "WindowPositionSettings": {"IsFullScreen": false, "Position": "286,286,800,452", "TopMost": false, "AllowTransparency": false, "CloseOnMonitorLoss": false, "NoWindowActivate": false}}, "Version": 2, "Id": "9c31538e-329d-4602-875c-3d12614a1792", "BaseHeight": 480, "BaseWidth": 850, "BackgroundColor": "#FF000000", "Screens": [{"RenderingSkip": 0, "Name": "Idle", "InGameScreen": false, "IdleScreen": true, "PitScreen": false, "ScreenId": "3791871a-3122-41a5-905e-279248049d51", "AllowOverlays": true, "IsForegroundLayer": false, "IsOverlayLayer": false, "OverlayTriggerExpression": {"Expression": ""}, "ScreenEnabledExpression": {"Expression": ""}, "OverlayMaxDuration": 0, "OverlayMinDuration": 0, "IsBackgroundLayer": false, "BackgroundColor": "#00FFFFFF", "Items": [{"$type": "SimHub.Plugins.OutputPlugins.GraphicalDash.Models.RectangleItem, SimHub.Plugins", "IsRectangleItem": 