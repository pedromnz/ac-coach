la": {"JSExt": 1, "Interpreter": 1, "Expression": "return acc_on() ? acc('fg','#FFFFFFFF') : '#FF8A8F99'"}, "Mode": 2}}}, {"$type": "SimHub.Plugins.OutputPlugins.GraphicalDash.Models.RectangleItem, SimHub.Plugins", "IsRectangleItem": true, "BackgroundColor": "#00FFFFFF", "BorderStyle": {"RadiusTopLeft": 4, "RadiusTopRight": 4, "RadiusBottomLeft": 4, "RadiusBottomRight": 4}, "Height": 14.0, "Left": 539.0, "Top": 204.0, "Visible": true, "BlinkPhasisInverted": false, "Width": 282.0, "Name": "Coach Bar BG", "RenderingSkip": 0, "MinimumRefreshIntervalMS": 0.0}, {"$type": "SimHub.Plugins.OutputPlugins.GraphicalDash.Models.RectangleItem, SimHub.Plugins", "IsRectangleItem": true, "BackgroundColor": "#00FFFFFF", "BorderStyle": {"RadiusTopLeft": 4, "RadiusTopRight": 4, "RadiusBottomLeft": 4, "RadiusBottomRight": 4}, "Height": 14.0, "Left": 539.0, "Top": 204.0, "Visible": true, "BlinkPhasisInverted": false, "Width": 169.2, "Name": "Coach Bar", "RenderingSkip": 0, "MinimumRefreshIntervalMS": 0.0, "Bindings": {"Width": {"Formula": {"JSExt": 1, "Interpreter": 1, "Expression": "return Math.max(1, 282 * (acc_on() ? acc_num('frac',0) : 0))"}, "Mode": 2}, "BackgroundColor": {"Formula": {"JSExt": 1, "Interpreter": 1, "Expression": "return acc('barc','#FF4FC3F7')"}, "Mode": 2}}}, {"$type": "SimHub.Plugins.OutputPlugins.GraphicalDash.Models.RectangleItem, SimHub.Plugins", "IsRectangleItem": true, "BackgroundColor": "#00FFFFFF", "Height": 24.0, "Left": 678.0, "Top": 199.0, "Visible": true, "BlinkPhasisInverted": false, "Width": 4.0, "Name": "Coach Bar Mark", "RenderingSkip": 0, "MinimumRefreshIntervalMS": 0.0, "Bindings": {"Left": {"Formula": {"JSExt": 1, "Interpreter": 1, "Expression": "return 539 + 282 * acc_num('mark',0) - 2"}, "Mode": 2}, "Visible": {"Formula": {"JSExt": 1, "Interpreter": 1, "Expression": "return acc_on() && acc_num('mark',-1) >= 0"}, "Mode": 2}}}, {"$type": "SimHub.Plugins.OutputPlugins.GraphicalDash.Models.TextItem, SimHub.Plugins", "IsTextItem": true, "Font": "Roboto", "FontWeight": "Bold", "FontSize": 13.0, "Text": "vs Minha ideal", "TextColor": "#B3FFFFFF", "HorizontalAlignment": 1, "VerticalAlignment": 1, "BackgroundColor": "#00FFFFFF", "Height": 20.0, "Left": 525.0, "Top": 226.0, "Visible": true, "BlinkPhasisInverted": false, "Width": 310.0, "Name": "Coach Mode", "RenderingSkip": 0, "MinimumRefreshIntervalMS": 0.0, "Bindings": {"Text": {"Formula": {"JSExt": 1, "Interpreter": 1, "Expression": "return acc_on() ? 'ref: ' + acc('mode','') : ''"}, "Mode": 2}, "TextColor": {"Formula": {"JSExt": 1, "Interpreter": 1, "Expression": "return acc_on() ? acc('fg','#FFFFFFFF') : '#FF8A8F99'"}, "Mode": 2}}}, {"$type": "SimHub.Plugins.OutputPlugins.GraphicalDash.Models.RectangleItem, SimHub.Plugins", "IsRectangleItem": true, "BackgroundColor": "#00FFFFFF", "BorderStyle": {"RadiusTopLeft": 12, "RadiusTopRight": 12, "RadiusBottomLeft": 12, "RadiusBottomRight": 12, "BorderTop": 2, "BorderBottom": 2, "BorderLeft": 2, "BorderRight": 2, "Bindings": {"BorderColor": {"Formula": {"JSExt": 1, "Interpreter": 1, "Expression": "return acc_low() ? '#FFFFFFFF' : ld_theme('ld_uiLine')"}, "Mode": 2}}}, "Height": 199.0, "Left": 515.0, "Top": 276.0, "Visible": true, "BlinkPhasisInverted": false, "Width": 330.0, "Name": "Speed Border", "RenderingSkip": 0, "MinimumRefreshIntervalMS": 0.0}, {"$type": "SimHub.Plugins.OutputPlugins.GraphicalDash.Models.TextItem, SimHub.Plugins", "IsTextItem": true, "Font": "Roboto", "FontWeight": "Bold", "FontSize": 12.0, "Text": "VELOCIDADE", "TextColor": "#FFFFFFFF", "HorizontalAlignment": 1, "VerticalAlignment": 1, "BackgroundColor": "#FF000000", "Height": 18.0, "Left": 632.0, "Top": 268.0, "Visible": true, "BlinkPhasisInverted": false, "Width": 96.0, "Name": "Speed Title", "RenderingSkip": 0, "MinimumRefreshIntervalMS": 0.0, "Bindings": {"BackgroundColor": {"Formula": {"JSExt": 1, "Interpreter": 1, "Expression": "return acc_low() ? '#FF570A0D' : ld_theme('ld_uiBg')"}, "Mode": 2}, "TextColor": {"Formula": {"JSExt": 1, "Interpreter": 1, "Expression": "return ld_theme('ld_uiTitleSmall')"}, "Mode": 2}}}, {"$type": "SimHub.Plugins.OutputPlugins.GraphicalDash.Models.TextItem, SimHub.Plugins", "IsTextItem": true, "Font": "Roboto", "FontWeight": "Bold", "FontSize": 15.0, "Text": "USE 3a", "TextColor": "#FFFFB300", "HorizontalAlignment": 0, "VerticalAlignment": 1, "BackgroundColor": "#00FFFFFF", "Height": 20.0, "Left": 529.0, "Top": 286.0, "Visible": true, "BlinkPhasisInverted": false, "Width": 120.0, "Name": "Speed Gear", "RenderingSkip": 0, "MinimumRefreshIntervalMS": 0.0, "Bindings": {"Text": {"Formula": {"JSExt": 1, "Interpreter": 1, "Expression": "return 'MARCHA ' + acc('rgear','')"}, "Mode": 2}, "Visible": {"Formula": {"JSExt": 1, "Interpreter": 1, "Expression": "return acc_on() && acc('wrong','0') == '1'"}, "Mode": 2}}}, {"$type": "SimHub.Plugins.OutputPlugins.GraphicalDash.Models.TextItem, SimHub.Plugins", "IsTextItem": true, "Font": "Roboto", "FontWeight": "Black", "FontSize": 96.0, "Text": "142", "TextColor": "#FFFFFFFF", "HorizontalAlignment": 2, "VerticalAlignment": 1, "BackgroundColor": "#00FFFFFF", "Height": 100.0, "Left": 525.0, "Top": 292.0, "Visible": true, "BlinkPhasisInverted": false, "Width": 215.0, "Name": "Speed Value", "RenderingSkip": 0, "MinimumRefreshIntervalMS": 0.0, "Bindings": {"Text": {"Formula": {"JSExt": 1, "Interpreter": 1, "Expression": "return acc_on() ? acc('spd','0') : format($prop('DataCorePlugin.GameData.SpeedLocal'),'0')"}, "Mode": 2}, "TextColor": {"Formula": {"JSExt": 1, "Interpreter": 1, "Expression": "return acc_low() ? '#FFFF5252' : '#FFFFFFFF'"}, "Mode": 2}}}, {"$type": "SimHub.Plugins.OutputPlugins.GraphicalDash.Models.TextItem, SimHub.Plugins", "IsTextItem": true, "Font": "Roboto", "FontWeight": "Bold", "FontSize": 20.0, "Text": "km/h", "TextColor": "#FF878787", "HorizontalAlignment": 0, "VerticalAlignment": 1, "BackgroundColor": "#00FFFFFF", "Height": 30.0, "Left": 745.0, "Top": 350.0, "Visible": true, "BlinkPhasisInverted": false, "Width": 80.