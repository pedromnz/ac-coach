sion": "return $prop('LovelyPlugin.TeamLINQ.LapTime.Best');"}, "Mode": 2}, "TextColor": {"Formula": {"JSExt": 1, "Interpreter": 1, "Expression": "var timeDiffOverall = timespantoseconds( $prop('LovelyPlugin.TeamLINQ.LapTime.Best') ) - timespantoseconds( ld_driverbestlap( $prop('LovelyPlugin.TeamLINQ.Session.BestLapOpponentPosition') ) )\r\n\r\nif ( timespantoseconds($prop('LovelyPlugin.TeamLINQ.LapTime.Best'))==0) {\r\n\treturn ld_theme('ld_uiNeutral')\r\n} else {\r\n\tif ( timeDiffOverall > 0 ) {\r\n\t\treturn ld_theme('ld_uiFaster')\r\n\t} else {\r\n\t\treturn ld_theme('ld_uiFastest')\r\n\t}\r\n}"}, "Mode": 2}}}, {"$type": "SimHub.Plugins.OutputPlugins.GraphicalDash.Models.TextItem, SimHub.Plugins", "IsTextItem": true, "Font": "Roboto", "FontWeight": "Bold", "FontSize": 12.0, "Text": "BEST LAP", "TextColor": "#FF878787", "HorizontalAlignment": 2, "VerticalAlignment": 1, "BackgroundColor": "#00FFFFFF", "Height": 14.0, "Left": 200.0, "Top": 351.0, "Visible": true, "BlinkPhasisInverted": false, "Width": 280.0, "Name": "BestLapLabel", "RenderingSkip": 32, "MinimumRefreshIntervalMS": 320.0, "Bindings": {"TextColor": {"Formula": {"JSExt": 1, "Interpreter": 1, "Expression": "return ld_theme('ld_uiLabel')"}, "Mode": 2}}}, {"$type": "SimHub.Plugins.OutputPlugins.GraphicalDash.Models.WidgetItem, SimHub.Plugins", "NextScreenCommand": 0, "PreviousScreenCommand": 0, "AutoSize": true, "FileName": "Fuel.djson", "InitialScreenIndex": 0, "FreezePageChanges": false, "EnableScreenRolesAndActivation": false, "IgnoreSavedScreensEx": true, "BackgroundColor": "#00FFFFFF", "Height": 97.0, "Left": 175.0, "Top": 383.0, "Visible": true, "BlinkPhasisInverted": false, "Width": 330.0, "Name": "Fuel", "RenderingSkip": 0, "MinimumRefreshIntervalMS": 0.0}, {"$type": "SimHub.Plugins.OutputPlugins.GraphicalDash.Models.RectangleItem, SimHub.Plugins", "IsRectangleItem": true, "BackgroundColor": "#00FFFFFF", "BorderStyle": {"RadiusTopLeft": 12, "RadiusTopRight": 12, "RadiusBottomLeft": 12, "RadiusBott